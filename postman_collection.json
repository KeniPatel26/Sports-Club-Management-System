{
  "info": {
    "name": "MERN Hackathon Starter API Collection",
    "description": "Production-ready Postman Collection for Hackathons covering Auth, Users, Projects, Tasks, Activities, AI, and Uploads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"email\": \"user@demo.com\",\n  \"password\": \"User@123\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"title\": \"Principal Architect\",\n  \"bio\": \"Leading scalable hackathon systems.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Projects (CRUD)",
      "item": [
        {
          "name": "Get Projects (with filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects?status=in-progress&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Get Project Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/stats", "host": ["{{baseUrl}}"], "path": ["projects", "stats"] }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Smart Telemetry Hub\",\n  \"description\": \"Real-time data dashboard\",\n  \"category\": \"Artificial Intelligence\",\n  \"status\": \"planning\",\n  \"priority\": \"high\",\n  \"budget\": 35000\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        }
      ]
    },
    {
      "name": "AI Services",
      "item": [
        {
          "name": "AI Summarize",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"MERN Stack provides MongoDB, Express, React, and Node.js for high velocity.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/summarize", "host": ["{{baseUrl}}"], "path": ["ai", "summarize"] }
          }
        },
        {
          "name": "AI Classify",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Critical payment gateway timeout during checkout operation.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/classify", "host": ["{{baseUrl}}"], "path": ["ai", "classify"] }
          }
        },
        {
          "name": "AI Chat Assistant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How do I customize the database models?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/chat", "host": ["{{baseUrl}}"], "path": ["ai", "chat"] }
          }
        }
      ]
    },
    {
      "name": "Activities & Notifications",
      "item": [
        {
          "name": "Get Recent Activities",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/activities", "host": ["{{baseUrl}}"], "path": ["activities"] }
          }
        },
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        }
      ]
    }
  ]
}
